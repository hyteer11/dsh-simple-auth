{
  "name": "dsh-simple-auth",
  "version": "1.0.0",
  "description": "Single-password authentication gate for the dsh web surface: configurable session validity, Ctrl+Shift+L lock, CLI password management, brute-force lockout, in-UI password controls.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyteer11/dsh-simple-auth.git"
  },
  "homepage": "https://github.com/hyteer11/dsh-simple-auth#readme",
  "bugs": {
    "url": "https://github.com/hyteer11/dsh-simple-auth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "auth",
    "authentication",
    "password",
    "lock",
    "lockout",
    "security"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "main": "lib/index.js",
  "bin": {
    "dsh-simple-auth": "lib/cli.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "doc",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/run.js"
  },
  "dependencies": {},
  "peerDependencies": {}
}
